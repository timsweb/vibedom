# Vibedom layer — built on top of a project's base image at runtime
# ARG BASE_IMAGE is passed by VMManager.build_project_image()
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Base images may drop to a non-root USER; installs and /root/... need root.
USER root

# Install required tools if not present in the project base image.
# Build runs before the proxy starts, so network is clean and unrestricted.
# openssh-client provides ssh-agent/ssh-add for startup.sh; ripgrep backs
# USE_BUILTIN_RIPGREP=0 below.
# For Alpine: upgrade musl to 1.2.5+ first (Claude requires posix_getdents, added in 1.2.5).
# Only musl is pulled from edge; everything else comes from the image's own repos.
RUN set -e; \
    if command -v apt-get >/dev/null; then \
        apt-get update -qq; \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git bash curl ca-certificates openssh-client ripgrep; \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null; then \
        apk del g++ musl-dev libc-dev 2>/dev/null || true; \
        apk add --no-cache --repository https://dl-cdn.alpinelinux.org/alpine/edge/main/ musl --upgrade; \
        apk add --no-cache git bash curl ca-certificates openssh-client libgcc libstdc++ ripgrep; \
    else \
        echo "vibedom: base image needs apt-get (Debian/Ubuntu) or apk (Alpine)" >&2; \
        exit 1; \
    fi

# Install Claude Code CLI
RUN curl -fsSL https://claude.ai/install.sh | bash

ENV USE_BUILTIN_RIPGREP=0
ENV PATH="/root/.local/bin:$PATH"

# Ensure /root/.local/bin is in PATH for login shells (bash --login sources
# /etc/profile which resets PATH, dropping the ENV above — so `claude` would
# vanish from `vibedom shell`/`attach`). Parity with Dockerfile.alpine.
RUN echo 'export PATH="/root/.local/bin:$PATH"' > /etc/profile.d/local-bin.sh

# Create required vibedom mount points
RUN mkdir -p /usr/local/share/ca-certificates /work /mnt/config

# Copy vibedom startup script
COPY startup.sh /usr/local/bin/vibedom-startup.sh
RUN chmod +x /usr/local/bin/vibedom-startup.sh

# Make SSH_AUTH_SOCK available in exec sessions
RUN echo '[ -f /tmp/ssh-agent.sock ] && export SSH_AUTH_SOCK=/tmp/ssh-agent.sock' > /etc/profile.d/vibedom-ssh.sh

ENTRYPOINT ["/usr/local/bin/vibedom-startup.sh"]
CMD []
